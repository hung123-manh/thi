/* c. Thực hiện loại bỏ ký tự đặc biệt, số, ký tự trùng và giữ nguyên thứ tự xuất hiện của chúng. Gửi thông điệp lên server theo định dạng "requestId;strOutput", trong đó strOutput là chuỗi đã được xử lý ở trên */

package UDP;

import java.net.*;
import java.util.*;

public class UDP_52gATgjz {
    public static void main(String[] args) throws Exception {

        DatagramSocket socket = new DatagramSocket();
        InetAddress serverAddress = InetAddress.getByName("36.50.135.242");
        int serverPort = 2208;

        // gui
        String message = ";B22DCAT134;52gATgjz";
        DatagramPacket sendPacket = new DatagramPacket(
                message.getBytes(),
                message.length(),
                serverAddress,
                serverPort
        );
        socket.send(sendPacket);

        // nhan
        byte[] buffer = new byte[1024];
        DatagramPacket receivePacket = new DatagramPacket(buffer, buffer.length);
        socket.receive(receivePacket);

        String received = new String(
                receivePacket.getData(),
                0,
                receivePacket.getLength()
        );
        System.out.println(received);

        // xu ly
        String[] parts = received.split(";");
        String requestId = parts[0];
        String s = parts[1];
        LinkedHashSet<Character> set = new LinkedHashSet<>();
        for(char c : s.toCharArray()){
            if(Character.isLetter(c)){
                set.add(c);
            }
        }
        String resultStr = "";
        for(char c : set){
            resultStr += c;
        }
        String result = requestId + ";" + resultStr;
        System.out.println(result);

        // gui ket qua
        DatagramPacket resultPacket = new DatagramPacket(
                result.getBytes(),
                result.length(),
                serverAddress,
                serverPort
        );
        socket.send(resultPacket);
        socket.close();
    }
}
